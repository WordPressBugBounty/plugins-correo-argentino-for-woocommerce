msgstr "Panel"

msgid "API Connection"
msgstr "Conexión API"

msgid "Commercial Data"
msgstr "Datos Comerciales"

msgid "Commercial Data MiCorreo"
msgstr "Datos Comerciales MiCorreo"

msgid "Commercial Data Paq.Ar"
msgstr "Datos Comerciales Paq.Ar"

msgid "Unauthorized or session expired."
msgstr "No autorizado o la sesión ha expirado."

msgid "Enable Sandbox Mode"
msgstr "Habilitar modo Desarrollo"

msgid "Sandbox Mode"
msgstr "Modo Desarrollo"

msgid ""
"Once logged in, to perform the environment change, it is necessary to "
"disable and re-enable the plugin."
msgstr ""
"Una vez logueado, para realizar el cambio de entorno es necesario "
"deshabilitar y volver a habilitar el plugin."

msgid "The order has already been imported to the MiCorreo API."
msgstr "La orden ya fue importada a la API de MiCorreo."

msgid "No orders available to export (or all have already been exported)."
msgstr ""
"No hay ordenes disponibles para exportar (o todas ya fueron exportadas)."

